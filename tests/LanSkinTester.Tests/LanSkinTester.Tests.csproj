<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin's tests. The launcher (Rust, src/Launcher) has its own tests (cargo test); what it writes for the
    server is in launcher-commands.json, which these tests check against the plugin.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>LanSkinTester.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The plugin leaves CounterStrikeSharp out of its output; the tests load the plugin's types, so they need it. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanSkinTester\LanSkinTester.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="launcher-commands.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
