<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LanSkinTesterLauncher</AssemblyName>
    <RootNamespace>LanSkinTester.Launcher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>LAN Skin Tester</Product>
    <!-- No designer files: controls are built in code. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- The UI: HTML/CSS/JS in web/, served from the exe by a local ASP.NET server and shown in WebView2. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Same item tables / loadout format as the plugin. -->
  <ItemGroup>
    <Compile Include="..\Plugin\Shared\ItemData.cs" Link="Shared\ItemData.cs" />
    <Compile Include="..\Plugin\Shared\Loadout.cs" Link="Shared\Loadout.cs" />
    <Compile Include="..\Plugin\Shared\ItemImport.cs" Link="Shared\ItemImport.cs" />
    <Compile Include="..\Plugin\Shared\ServerStatus.cs" Link="Shared\ServerStatus.cs" />
  </ItemGroup>

  <!-- The built plugin ships inside the exe (build.sh builds the plugin first). -->
  <ItemGroup>
    <EmbeddedResource Include="$(PluginOutput)LanSkinTester.dll" LogicalName="plugin/LanSkinTester.dll" Condition="'$(PluginOutput)' != ''" />
    <EmbeddedResource Include="$(PluginOutput)gamedata\lanskintester.json" LogicalName="plugin/gamedata/lanskintester.json" Condition="'$(PluginOutput)' != ''" />
  </ItemGroup>

</Project>
